# 本地默认：SQLite
DATABASE_URL="file:./dev.db"
JWT_SECRET="qfnu-meeting-dev-secret-change-me"
PORT=3000
UPLOAD_DIR="./uploads"
# 开发可留空（允许任意来源）；生产请配置白名单，逗号分隔
# CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
# NODE_ENV=production

# —— AI / 大模型（材料智能摘要等）——
# 不配置 LLM_API_KEY 时走本地演示摘要，链路仍可完整演示
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=openai_compatible
# 国内兼容网关示例（阿里云 DashScope / 通义千问，对齐 zxyun）：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# 本机 Clash Fake-IP 导致 fetch failed 时，固定解析到真实 IP（与 zxyun AI_ENDPOINT_IPV4 一致）
# LLM_ENDPOINT_IPV4=39.96.198.249
# LLM_TIMEOUT_MS=45000
