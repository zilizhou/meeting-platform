# 本地默认：SQLite
DATABASE_URL="file:./dev.db"
JWT_SECRET="qfnu-meeting-dev-secret-change-me"
# 访问令牌有效期（等保建议 ≤8h）
JWT_EXPIRES_IN=8h
PORT=3000
UPLOAD_DIR="./uploads"
# 开发可留空（允许任意来源）；生产请配置白名单，逗号分隔
# CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
# NODE_ENV=production

# —— 身份鉴别（等保）——
# 演示机可开：ALLOW_WEAK_PASSWORD=1（允许 123456）；生产务必关闭
ALLOW_WEAK_PASSWORD=1
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=30
# 重新 seed 时是否强制演示账号首次改密（默认否）
# SEED_FORCE_PASSWORD_CHANGE=0

# —— 审计（等保）——
# 在线留存天数（不少于 180；系统不做自动清理）
AUDIT_RETENTION_DAYS=180
# 生产严禁开启；仅 seed/演示清库脚本临时使用
# ALLOW_AUDIT_WIPE=0

# —— 暴露面（等保）——
# 生产默认关 Swagger；临时排查可 ENABLE_SWAGGER=1
# ENABLE_SWAGGER=0
# 生产默认只监听本机（经 nginx 反代）；本地开发可不设
# BIND_HOST=127.0.0.1
# 全局限流：每 IP 每分钟请求数
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# 登录更严
THROTTLE_LOGIN_LIMIT=20
THROTTLE_LOGIN_TTL_MS=60000

# —— AI / 大模型（材料智能摘要等）——
# 不配置 LLM_API_KEY 时走本地演示摘要，链路仍可完整演示
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=openai_compatible
# 国内兼容网关示例（阿里云 DashScope / 通义千问，对齐 zxyun）：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# 本机 Clash Fake-IP 导致 fetch failed 时，固定解析到真实 IP（与 zxyun AI_ENDPOINT_IPV4 一致）
# LLM_ENDPOINT_IPV4=39.96.198.249
# LLM_TIMEOUT_MS=45000
