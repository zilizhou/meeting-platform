# 复制为部署环境的 .env；不要提交真实值。
NODE_ENV=production
DATABASE_URL="mysql://meeting:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:3306/qfnu_meeting"
JWT_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"
PORT=3000
UPLOAD_DIR="/var/lib/qfnu-meeting/uploads"
CORS_ORIGIN="https://meeting.example.edu.cn,https://meeting-admin.example.edu.cn"
JWT_EXPIRES_IN=8h
ALLOW_WEAK_PASSWORD=0
AUDIT_RETENTION_DAYS=180
# 仅经 nginx 反代访问 API
BIND_HOST=127.0.0.1
ENABLE_SWAGGER=0
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_LOGIN_LIMIT=20
THROTTLE_LOGIN_TTL_MS=60000

# 可选：不配置时使用本地演示生成。
LLM_API_KEY=
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
LLM_PROVIDER="openai_compatible"
LLM_TIMEOUT_MS=45000
