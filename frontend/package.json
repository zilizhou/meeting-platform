    "preview:system": "vite preview --config vite.system.config.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.18.1",
    "element-plus": "^2.14.2",
    "marked": "^18.0.11",
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-router": "4"
  },
  "devDependencies": {
    "@types/marked": "^6.0.0",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "sass": "^1.101.0",
    "typescript": "~6.0.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.5"
  }
