{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:system": "vite --config vite.system.config.ts",
    "build": "vue-tsc -b && vite build",
    "build:system": "vue-tsc -b && vite build --config vite.system.config.ts",
